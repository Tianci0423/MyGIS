<Window x:Class="GeoVision.Dialogs.RasterSwipeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卷帘对比" Width="470" Height="285" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="选择显示在分隔线左右两侧的栅格影像。进入后可拖动分隔线实时对比。"
                   Foreground="#526678" FontSize="12.5" TextWrapping="Wrap"
                   Margin="0,0,0,18"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="左侧影像" VerticalAlignment="Center" Foreground="#294155" FontWeight="SemiBold"/>
            <ComboBox x:Name="LeftImageBox" Grid.Column="1" Height="32"
                      DisplayMemberPath="Name" SelectedIndex="0"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="右侧影像" VerticalAlignment="Center" Foreground="#294155" FontWeight="SemiBold"/>
            <ComboBox x:Name="RightImageBox" Grid.Column="1" Height="32"
                      DisplayMemberPath="Name" SelectedIndex="1"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <TextBlock x:Name="ValidationText" Foreground="#DC2626" FontSize="11.5"
                       VerticalAlignment="Center" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="交换左右" Width="82" Height="30" Margin="0,0,18,0"
                        Click="OnSwapClick" Background="#E5EDF2" Foreground="#294155"
                        BorderThickness="0" Cursor="Hand"/>
                <Button Content="开始对比" Width="82" Height="30" Margin="0,0,8,0"
                        Click="OnConfirmClick" Background="#1677A8" Foreground="White"
                        BorderThickness="0" Cursor="Hand"/>
                <Button Content="取消" Width="68" Height="30" Click="OnCancelClick"
                        Background="#E5E7EB" Foreground="#334155"
                        BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
