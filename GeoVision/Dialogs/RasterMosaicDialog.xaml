<Window x:Class="GeoVision.Dialogs.RasterMosaicDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="影像拼接" Width="680" Height="560" MinWidth="620" MinHeight="530"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="基准影像" VerticalAlignment="Center" Foreground="#334155"/>
            <ComboBox x:Name="BaseBox" Grid.Column="1" Height="30" IsEditable="True"
                      DisplayMemberPath="Name" SelectionChanged="OnInputChanged"
                      LostKeyboardFocus="OnInputLostFocus"/>
            <Button Grid.Column="2" Content="浏览" Height="30" Margin="8,0,0,0" Click="OnBrowseBase"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="待拼接影像" VerticalAlignment="Center" Foreground="#334155"/>
            <ComboBox x:Name="OverlayBox" Grid.Column="1" Height="30" IsEditable="True"
                      DisplayMemberPath="Name" SelectionChanged="OnInputChanged"
                      LostKeyboardFocus="OnInputLostFocus"/>
            <Button Grid.Column="2" Content="浏览" Height="30" Margin="8,0,0,0" Click="OnBrowseOverlay"/>
        </Grid>

        <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="InputInfoText" Text="请选择两幅具有重叠区域的地理参考影像。"
                       Foreground="#1E3A8A" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/><ColumnDefinition Width="210"/>
                <ColumnDefinition Width="112"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="重叠区匀色" VerticalAlignment="Center" Foreground="#334155"/>
            <ComboBox x:Name="BalanceBox" Grid.Column="1" Height="30" SelectedIndex="0">
                <ComboBoxItem Content="直方图匹配（推荐）" Tag="Histogram"/>
                <ComboBoxItem Content="均值/方差匹配" Tag="Linear"/>
                <ComboBoxItem Content="不匀色" Tag="None"/>
            </ComboBox>
            <TextBlock Grid.Column="2" Text="羽化距离（像元）" Margin="16,0,0,0"
                       VerticalAlignment="Center" Foreground="#334155"/>
            <TextBox x:Name="FeatherBox" Grid.Column="3" Height="30" Text="128"
                     VerticalContentAlignment="Center" ToolTip="接缝两侧渐变融合宽度，建议 64～256，最大 1024"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/><ColumnDefinition Width="210"/>
                <ColumnDefinition Width="112"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="重采样" VerticalAlignment="Center" Foreground="#334155"/>
            <ComboBox x:Name="ResamplingBox" Grid.Column="1" Height="30" SelectedIndex="1">
                <ComboBoxItem Content="双线性" Tag="bilinear"/>
                <ComboBoxItem Content="三次卷积（推荐）" Tag="cubic"/>
                <ComboBoxItem Content="最近邻" Tag="nearest"/>
                <ComboBoxItem Content="Lanczos" Tag="lanczos"/>
            </ComboBox>
            <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="#64748B" Text="输出网格"/>
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#64748B"
                       Text="采用基准影像坐标系与分辨率"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="输出文件" VerticalAlignment="Center" Foreground="#334155"/>
            <TextBox x:Name="OutputBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>
            <Button Grid.Column="2" Content="浏览" Height="30" Margin="8,0,0,0" Click="OnBrowseOutput"/>
        </Grid>

        <Border Grid.Row="6" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                CornerRadius="4" Padding="10" VerticalAlignment="Top">
            <TextBlock Foreground="#92400E" TextWrapping="Wrap">
                <Run Text="处理说明：先将待拼接影像对齐到基准网格，仅使用两幅影像的共同有效区域估计颜色映射，再按有效边界距离进行羽化融合。"/>
                <LineBreak/>
                <Run Text="若两幅影像存在明显位置错位，请先执行影像配准；匀色与羽化不能消除几何双影。"/>
            </TextBlock>
        </Border>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <CheckBox x:Name="LoadResultBox" Content="完成后加载结果" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,18,0"/>
            <Button Content="开始拼接" Width="104" Height="32" Click="OnRunClick"
                    Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="取消" Width="72" Height="32" Click="OnCancelClick" Margin="8,0,0,0"
                    Background="#E5E7EB" Foreground="#334155" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
