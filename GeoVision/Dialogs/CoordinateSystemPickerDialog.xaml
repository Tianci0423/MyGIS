<Window x:Class="GeoVision.Dialogs.CoordinateSystemPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择坐标系" Width="880" Height="640" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC" Loaded="OnLoaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap" Foreground="#1E3A8A"
                       Text="从 GDAL/PROJ 的 EPSG 坐标系库中搜索，也可以输入 EPSG、WKT、PROJ 字符串，或从影像和 .prj 文件导入。"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="108"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="搜索" VerticalAlignment="Center" Foreground="#334155"/>
            <TextBox x:Name="SearchBox" Grid.Column="1" Height="30"
                     VerticalContentAlignment="Center" TextChanged="OnSearchChanged"
                     ToolTip="可输入名称或 EPSG 编号，例如 CGCS2000、UTM 48N、4548"/>
            <TextBlock Grid.Column="2" Text="坐标系类型" Margin="16,0,0,0"
                       VerticalAlignment="Center" Foreground="#334155"/>
            <ComboBox x:Name="CategoryBox" Grid.Column="3" Height="30" SelectedIndex="0"
                      SelectionChanged="OnCategoryChanged">
                <ComboBoxItem Content="全部" Tag="all"/>
                <ComboBoxItem Content="地理坐标系" Tag="geographic"/>
                <ComboBoxItem Content="投影坐标系" Tag="projected"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="285"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="White" CornerRadius="3">
                <ListView x:Name="CatalogList" BorderThickness="0"
                          SelectionChanged="OnCatalogSelectionChanged"
                          MouseDoubleClick="OnCatalogDoubleClick"
                          ScrollViewer.IsDeferredScrollingEnabled="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="类型" Width="92" DisplayMemberBinding="{Binding CategoryDisplay}"/>
                            <GridViewColumn Header="EPSG" Width="72" DisplayMemberBinding="{Binding Code}"/>
                            <GridViewColumn Header="坐标系名称" Width="390" DisplayMemberBinding="{Binding Name}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <Border Grid.Column="1" Margin="12,0,0,0" Padding="12" Background="White"
                    BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="坐标系信息" FontWeight="SemiBold" Foreground="#0F172A"/>
                    <TextBlock x:Name="DetailsText" Grid.Row="1" Margin="0,10,0,10"
                               Text="请选择或输入坐标系。" TextWrapping="Wrap"
                               Foreground="#475569"/>
                    <TextBlock x:Name="CatalogStatusText" Grid.Row="2" Foreground="#64748B"
                               Text="正在准备坐标系库……" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="92"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="自定义定义" VerticalAlignment="Top" Margin="0,7,0,0" Foreground="#334155"/>
            <TextBox x:Name="CustomCrsBox" Grid.Column="1" Height="58" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     TextChanged="OnCustomCrsChanged"
                     ToolTip="支持 EPSG:4490、4490、WKT 或 PROJ 字符串"/>
            <Button Grid.Column="2" Content="验证" Height="30" Margin="8,0,0,0"
                    VerticalAlignment="Top" Click="OnValidateCustom"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="从影像导入…" Width="112" Height="32" Click="OnImportRaster"/>
                <Button Content="从 .prj/WKT 导入…" Width="132" Height="32" Margin="8,0,0,0"
                        Click="OnImportDefinition"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确定" Width="88" Height="32" Click="OnAccept"
                        Background="#2563EB" Foreground="White" BorderThickness="0"/>
                <Button Content="取消" Width="72" Height="32" Margin="8,0,0,0" Click="OnCancel"
                        Background="#E5E7EB" Foreground="#334155" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
