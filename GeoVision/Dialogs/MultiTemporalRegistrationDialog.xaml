<Window x:Class="GeoVision.Dialogs.MultiTemporalRegistrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="多时相影像配准工具" Width="1440" Height="920"
        MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="76"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="待配准影像" VerticalAlignment="Center" Foreground="#334155"/>
            <ComboBox x:Name="MovingPathBox" Grid.Column="1" IsEditable="True"
                      DisplayMemberPath="Name" DropDownClosed="OnMovingPathSelected"/>
            <Button Grid.Column="2" Content="浏览…" Margin="7,0,0,0" Click="OnBrowseMoving"/>
            <TextBlock Grid.Column="4" Text="基准影像" VerticalAlignment="Center" Foreground="#334155"/>
            <ComboBox x:Name="ReferencePathBox" Grid.Column="5" IsEditable="True"
                      DisplayMemberPath="Name" DropDownClosed="OnReferencePathSelected"/>
            <Button Grid.Column="6" Content="浏览…" Margin="7,0,0,0" Click="OnBrowseReference"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="LoadButton" Content="加载双视图" Click="OnLoadImages"
                    Background="#2563EB" Foreground="White" BorderBrush="#2563EB"/>
            <Button x:Name="AddPointButton" Grid.Column="1" Content="采集控制点" Margin="8,0,0,0"
                    Click="OnTogglePointCapture" IsEnabled="False"/>
            <Button Grid.Column="2" Content="清除待选点" Margin="8,0,0,0" Click="OnCancelPendingPoint"/>
            <Border Grid.Column="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                    CornerRadius="3" Padding="9,5" Margin="12,0">
                <TextBlock x:Name="CaptureStatusText" Text="加载两幅影像后开始采集同名控制点。"
                           Foreground="#1E3A8A" TextWrapping="Wrap"/>
            </Border>
            <TextBlock Grid.Column="4" x:Name="CrsWarningText" VerticalAlignment="Center"
                       Foreground="#B45309" FontWeight="SemiBold"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#94A3B8" BorderThickness="1" Background="#111827">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Background="#E2E8F0" LastChildFill="True">
                        <TextBlock Text="待配准影像" FontWeight="SemiBold" Foreground="#1E293B" Margin="8,5"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,5,8,5">
                            <TextBlock Text="缩放" Margin="12,0,5,0" VerticalAlignment="Center"/>
                            <Slider x:Name="MovingZoomSlider" Width="130" Minimum="0.25" Maximum="6"
                                    Value="0.6" TickFrequency="0.25" ValueChanged="OnMovingZoomChanged"/>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer x:Name="MovingScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto" Background="#111827">
                        <Grid x:Name="MovingSurface" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="MovingScale" ScaleX="0.6" ScaleY="0.6"/>
                            </Grid.LayoutTransform>
                            <Image x:Name="MovingImage" Stretch="Fill" SnapsToDevicePixels="True"/>
                            <Canvas x:Name="MovingOverlay" Background="Transparent"
                                    MouseLeftButtonDown="OnMovingImageClick"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="#94A3B8" BorderThickness="1" Background="#111827">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Background="#E2E8F0" LastChildFill="True">
                        <TextBlock Text="基准影像" FontWeight="SemiBold" Foreground="#1E293B" Margin="8,5"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,5,8,5">
                            <TextBlock Text="缩放" Margin="12,0,5,0" VerticalAlignment="Center"/>
                            <Slider x:Name="ReferenceZoomSlider" Width="130" Minimum="0.25" Maximum="6"
                                    Value="0.6" TickFrequency="0.25" ValueChanged="OnReferenceZoomChanged"/>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer x:Name="ReferenceScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto" Background="#111827">
                        <Grid x:Name="ReferenceSurface" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="ReferenceScale" ScaleX="0.6" ScaleY="0.6"/>
                            </Grid.LayoutTransform>
                            <Image x:Name="ReferenceImage" Stretch="Fill" SnapsToDevicePixels="True"/>
                            <Canvas x:Name="ReferenceOverlay" Background="Transparent"
                                    MouseLeftButtonDown="OnReferenceImageClick"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,9,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="控制点列表" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="删除选中" Margin="12,0,0,0" Padding="9,2" MinHeight="25" Click="OnDeleteSelected"/>
                    <Button Content="全部清除" Margin="6,0,0,0" Padding="9,2" MinHeight="25" Click="OnClearAll"/>
                </StackPanel>
                <DataGrid x:Name="ControlPointGrid" Grid.Row="1" ItemsSource="{Binding ControlPoints}"
                          AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="38"/>
                        <DataGridTextColumn Header="待配准 X" Binding="{Binding MovingX, StringFormat={}{0:F3}}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="待配准 Y" Binding="{Binding MovingY, StringFormat={}{0:F3}}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="基准 X" Binding="{Binding ReferenceX, StringFormat={}{0:F3}}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="基准 Y" Binding="{Binding ReferenceY, StringFormat={}{0:F3}}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="残差" Binding="{Binding Residual, StringFormat={}{0:F3}}" IsReadOnly="True" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="1" Margin="10,0,0,0" BorderBrush="#CBD5E1" BorderThickness="1"
                    Background="White" CornerRadius="4" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="变换模型" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ModelBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnModelChanged">
                                <ComboBoxItem Content="平移（至少 1 点）" Tag="Translation"/>
                                <ComboBoxItem Content="相似（至少 2 点）" Tag="Similarity"/>
                                <ComboBoxItem Content="仿射（至少 3 点）" Tag="Affine"/>
                            </ComboBox>
                        </Grid>
                        <Border Grid.Row="1" Background="#F1F5F9" Padding="8" Margin="0,0,0,7">
                            <TextBlock x:Name="FitInfoText" Text="尚未计算" TextWrapping="Wrap" Foreground="#334155"/>
                        </Border>
                        <Button Grid.Row="2" Content="重新计算残差" Click="OnRecalculate" Margin="0,0,0,7"/>
                        <Grid Grid.Row="3" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="输出方式" VerticalAlignment="Center"/>
                            <ComboBox x:Name="OutputModeBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnOutputModeChanged">
                                <ComboBoxItem Content="仅更新坐标仿射（像元不变）" Tag="GeoreferenceOnly"/>
                                <ComboBoxItem Content="重采样到基准影像网格" Tag="ResampleToReferenceGrid"/>
                            </ComboBox>
                        </Grid>
                        <Grid Grid.Row="4" Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="重采样方法" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ResamplingBox" Grid.Column="1" SelectedIndex="1" IsEnabled="False">
                                <ComboBoxItem Content="最近邻" Tag="nearest"/>
                                <ComboBoxItem Content="双线性" Tag="bilinear"/>
                                <ComboBoxItem Content="三次卷积" Tag="cubic"/>
                                <ComboBoxItem Content="Lanczos" Tag="lanczos"/>
                            </ComboBox>
                        </Grid>
                        <TextBlock Grid.Row="5" Foreground="#92400E" TextWrapping="Wrap"
                                   Text="“仅更新坐标仿射”会完整复制原影像，只修改输出文件的坐标系和 6 参数仿射信息，不裁剪、不重采样、不改变像元值。"/>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="输出文件" VerticalAlignment="Center"/>
            <TextBox x:Name="OutputPathBox" Grid.Column="1"/>
            <Button Grid.Column="2" Content="浏览…" Margin="7,0,0,0" Click="OnBrowseOutput"/>
            <CheckBox x:Name="LoadResultBox" Grid.Column="3" Content="完成后加载结果" IsChecked="True"
                      VerticalAlignment="Center" Margin="15,0"/>
            <Button Grid.Column="4" Content="开始配准" Width="100" Click="OnRun"
                    Background="#2563EB" Foreground="White" BorderBrush="#2563EB"/>
            <Button Grid.Column="5" Content="取消" Width="72" Margin="8,0,0,0" Click="OnCancel"/>
        </Grid>
    </Grid>
</Window>
