<Window x:Class="GeoVision.Dialogs.RasterDefineProjectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="定义投影" Width="680" Height="500" MinWidth="610" MinHeight="470"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="78"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="输入影像" VerticalAlignment="Center" Foreground="#334155"/>
            <ComboBox x:Name="InputBox" Grid.Column="1" Height="30" IsEditable="True"
                      DisplayMemberPath="Name" DropDownClosed="OnInputDropDownClosed"
                      LostKeyboardFocus="OnInputLostFocus"/>
            <Button Grid.Column="2" Content="浏览" Height="30" Margin="8,0,0,0" Click="OnBrowseInput"/>
        </Grid>

        <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="SourceInfoText" Text="请选择 GeoTIFF 影像。"
                       Foreground="#1E3A8A" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="78"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="坐标系定义" VerticalAlignment="Center" Foreground="#334155"/>
            <TextBox x:Name="TargetCrsBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                     ToolTip="可输入 EPSG、WKT 或 PROJ 字符串" LostKeyboardFocus="OnTargetLostFocus"/>
            <Button Grid.Column="2" Content="选择…" Height="30" Margin="8,0,0,0" Click="OnSelectCrs"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="100,0,0,10">
            <RadioButton x:Name="CopyModeRadio" Content="创建新影像（推荐）" IsChecked="True"
                         Checked="OnModeChanged"/>
            <RadioButton x:Name="InPlaceModeRadio" Content="直接修改输入文件" Margin="22,0,0,0"
                         Checked="OnModeChanged"/>
        </StackPanel>

        <Grid x:Name="OutputRow" Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="78"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="输出文件" VerticalAlignment="Center" Foreground="#334155"/>
            <TextBox x:Name="OutputBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>
            <Button Grid.Column="2" Content="浏览" Height="30" Margin="8,0,0,0" Click="OnBrowseOutput"/>
        </Grid>

        <Border Grid.Row="5" Background="#FEF2F2" BorderBrush="#FECACA"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <TextBlock Foreground="#991B1B" TextWrapping="Wrap"
                       Text="定义投影只写入或更正坐标系标签，不会转换坐标、移动像元或重采样。必须确认影像原本就真实使用所选坐标系；若需要把数据转换到另一个坐标系，请使用“投影转换（重投影）”。"/>
        </Border>

        <TextBlock Grid.Row="6" Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Top"
                   Text="“创建新影像”会完整复制像元后写入定义，原文件不变；“直接修改”会安全生成临时副本后替换原文件，已加载或被其他程序占用时可能失败。"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <CheckBox x:Name="LoadResultBox" Content="完成后加载结果" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,18,0"/>
            <Button Content="定义投影" Width="104" Height="32" Click="OnRunClick"
                    Background="#2563EB" Foreground="White" BorderThickness="0"/>
            <Button Content="取消" Width="72" Height="32" Click="OnCancelClick" Margin="8,0,0,0"
                    Background="#E5E7EB" Foreground="#334155" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
