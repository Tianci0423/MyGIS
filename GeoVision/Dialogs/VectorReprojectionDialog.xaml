<Window x:Class="GeoVision.Dialogs.VectorReprojectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="矢量重投影" Width="620" Height="330" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
            <TextBlock Text="输入矢量" VerticalAlignment="Center" Foreground="#334155"/>
            <ComboBox x:Name="InputBox" Grid.Column="1" Height="30" IsEditable="True"
                      DisplayMemberPath="Name" SelectionChanged="OnInputChanged"/>
            <Button Grid.Column="2" Content="浏览" Height="30" Margin="8,0,0,0" Click="OnBrowseInput"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
            <TextBlock Text="目标坐标系" VerticalAlignment="Center" Foreground="#334155"/>
            <TextBox x:Name="TargetCrsBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>
            <Button Grid.Column="2" Content="选择" Height="30" Margin="8,0,0,0" Click="OnSelectCrs"/>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="InfoText" Foreground="#526678" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
            <TextBlock Text="输出 GeoJSON" VerticalAlignment="Center" Foreground="#334155"/>
            <TextBox x:Name="OutputBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>
            <Button Grid.Column="2" Content="浏览" Height="30" Margin="8,0,0,0" Click="OnBrowseOutput"/>
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="开始重投影" Width="100" Height="32" Click="OnRunClick"
                    Background="#1677A8" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="取消" Width="72" Height="32" Margin="8,0,0,0"
                    Click="OnCancelClick" Background="#E5E7EB" Foreground="#334155"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
