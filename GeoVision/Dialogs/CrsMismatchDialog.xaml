<Window x:Class="GeoVision.Dialogs.CrsMismatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="坐标系不一致" Width="520" Height="250" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageText" FontSize="13" Foreground="#294155"
                   TextWrapping="Wrap" Margin="0,0,0,18"/>
        <TextBlock Grid.Row="1" Text="立即重投影会生成新的临时 GeoTIFF，原始影像不会被修改。"
                   FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,18"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ReprojectButton" Content="立即重投影" Width="100" Height="32"
                    Margin="0,0,8,0" Click="OnReprojectClick"
                    Background="#1677A8" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="继续加载" Width="90" Height="32" Margin="0,0,8,0"
                    Click="OnContinueClick" Background="#E5EDF2" Foreground="#294155"
                    BorderThickness="0" Cursor="Hand"/>
            <Button Content="取消" Width="70" Height="32" Click="OnCancelClick"
                    Background="#E5E7EB" Foreground="#334155"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
