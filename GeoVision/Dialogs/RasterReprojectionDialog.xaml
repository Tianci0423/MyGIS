<Window x:Class="GeoVision.Dialogs.RasterReprojectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="投影转换（重投影）" Width="660" Height="500" MinWidth="590" MinHeight="470"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="98"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="78"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="输入影像" VerticalAlignment="Center" Foreground="#334155"/>
            <ComboBox x:Name="InputBox" Grid.Column="1" Height="30" IsEditable="True"
                      DisplayMemberPath="Name" DropDownClosed="OnInputDropDownClosed"
                      LostKeyboardFocus="OnInputLostFocus"/>
            <Button Grid.Column="2" Content="浏览" Height="30" Margin="8,0,0,0"
                    Click="OnBrowseInput"/>
        </Grid>

        <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="SourceInfoText" Text="请选择带坐标系的栅格影像。"
                       Foreground="#1E3A8A" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="98"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="78"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="目标坐标系" VerticalAlignment="Center" Foreground="#334155"/>
            <ComboBox x:Name="TargetCrsBox" Grid.Column="1" Height="30" IsEditable="True"
                      LostKeyboardFocus="OnTargetCrsLostFocus"/>
            <Button Grid.Column="2" Content="选择…" Height="30" Margin="8,0,0,0"
                    Click="OnSelectTargetCrs"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="98"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="重采样" VerticalAlignment="Center" Foreground="#334155"/>
            <ComboBox x:Name="ResamplingBox" Grid.Column="1" Height="30" SelectedIndex="1">
                <ComboBoxItem Content="最近邻（分类数据）" Tag="nearest"/>
                <ComboBoxItem Content="双线性（普通影像）" Tag="bilinear"/>
                <ComboBoxItem Content="三次卷积（高质量）" Tag="cubic"/>
                <ComboBoxItem Content="Lanczos（锐利）" Tag="lanczos"/>
            </ComboBox>
            <TextBlock Grid.Column="2" Text="目标像元大小" Margin="18,0,0,0"
                       VerticalAlignment="Center" Foreground="#334155"/>
            <TextBox x:Name="ResolutionBox" Grid.Column="3" Height="30"
                     VerticalContentAlignment="Center" ToolTip="留空时由 GDAL 自动估算；单位为目标坐标系单位"/>
        </Grid>

        <TextBlock Grid.Row="4" Margin="98,-4,0,10" Foreground="#64748B"
                   Text="可直接选择完整 EPSG 坐标系库，也可输入 EPSG、WKT、PROJ 字符串或从其他影像/.prj 导入；目标像元大小留空时自动估算。"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="98"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="78"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="输出文件" VerticalAlignment="Center" Foreground="#334155"/>
            <TextBox x:Name="OutputBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>
            <Button Grid.Column="2" Content="浏览" Height="30" Margin="8,0,0,0"
                    Click="OnBrowseOutput"/>
        </Grid>

        <Border Grid.Row="6" Background="#FFFBEB" BorderBrush="#FDE68A"
                BorderThickness="1" CornerRadius="4" Padding="10" VerticalAlignment="Top">
            <TextBlock Foreground="#92400E" TextWrapping="Wrap"
                       Text="重投影会改变像元网格和空间范围，但不会修改原始影像。连续影像建议双线性或三次卷积；土地分类、掩膜等离散数据必须使用最近邻。"/>
        </Border>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <CheckBox x:Name="LoadResultBox" Content="完成后加载结果" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,18,0"/>
            <Button Content="开始转换" Width="104" Height="32" Click="OnRunClick"
                    Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="取消" Width="72" Height="32" Click="OnCancelClick" Margin="8,0,0,0"
                    Background="#E5E7EB" Foreground="#334155" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
