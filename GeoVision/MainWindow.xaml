<Window x:Class="GeoVision.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        xmlns:controls="clr-namespace:GeoVision.Controls"
        mc:Ignorable="d"
        Title="GeoVision · Desktop GIS" Height="800" Width="1280" MinHeight="660" MinWidth="1040"
        Icon="Assets/GeoVision.ico"
        Background="{StaticResource GisCanvasBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="ChromeBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelBg" Color="#F6F8FA"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#C9D3DC"/>
        <SolidColorBrush x:Key="TextMain" Color="#1D2C38"/>
        <SolidColorBrush x:Key="TextMuted" Color="#607382"/>
        <SolidColorBrush x:Key="Accent" Color="#1677A8"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#E7F2F7"/>

        <Style x:Key="TopMenuItem" TargetType="MenuItem">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#F4F8FB"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EDF3F6"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#D1DEE5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DDEAF0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A9C6D3"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F5F7"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#B8CCD6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="SelectedBar" Height="3" Margin="7,0" CornerRadius="2,2,0,0"
                                    Background="{StaticResource Accent}" VerticalAlignment="Bottom"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EDF3F6"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#D1DEE5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5F0F4"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="SelectedBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#B8CCD6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stroke" Value="#334155"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>

        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#294155"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="ToolGroupLabel" TargetType="TextBlock">
            <Setter Property="Height" Value="14"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="#7B8E9B"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolSep" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#D3DCE2"/>
            <Setter Property="Margin" Value="7,2,7,14"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="EmptyActionButton" TargetType="Button">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#126A97"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0D587F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ExpandToggle" TargetType="ToggleButton">
            <Border Background="Transparent" Width="18" Height="18">
                <Path x:Name="Arrow" Stroke="#64748B" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M6,4 L11,9 L6,14"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Arrow" Property="Data" Value="M4,7 L9,12 L14,7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="TextBox" x:Key="SearchBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="28,5,8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C5D1DA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="40" Background="{StaticResource GisNavyBrush}">
            <DockPanel LastChildFill="True">
                <Menu Height="40" Background="Transparent" Foreground="White">
                    <Menu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            <Setter Property="FontSize" Value="12.5"/>
                            <Setter Property="Padding" Value="10,6"/>
                        </Style>
                    </Menu.Resources>
                    <MenuItem Header="文件" Style="{StaticResource TopMenuItem}">
                        <MenuItem Header="新建" Click="OnFileNew"/>
                        <Separator/>
                        <MenuItem Header="打开项目" Click="OnMenuOpen"/>
                        <MenuItem Header="保存项目" Click="OnMenuSave"/>
                        <MenuItem Header="另存为" Click="OnMenuSaveAs"/>
                        <MenuItem x:Name="RecentProjectsMenu" Header="最近打开"/>
                        <Separator/>
                        <MenuItem Header="添加数据" Click="OnAddDataClick"/>
                    </MenuItem>
                    <MenuItem Header="视图" Style="{StaticResource TopMenuItem}">
                        <MenuItem x:Name="OverviewMenuItem" Header="鹰眼地图"
                                  IsCheckable="True" IsChecked="False"
                                  Click="OnOverviewToggleClick"/>
                    </MenuItem>
                    <MenuItem Header="分析" Style="{StaticResource TopMenuItem}">
                        <MenuItem Header="波段计算器" Click="OnBandCalculator"/>
                        <MenuItem Header="影像裁剪" Click="OnRasterClip"/>
                    </MenuItem>
                    <MenuItem Header="工具" Style="{StaticResource TopMenuItem}">
                        <MenuItem Header="坐标系统">
                            <MenuItem Header="定义投影…" Click="OnDefineProjection"/>
                            <MenuItem Header="投影转换（重投影）…" Click="OnRasterReprojection"/>
                            <MenuItem Header="矢量重投影…" Click="OnVectorReprojection"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="多时相影像配准…" Click="OnMultiTemporalRegistration"/>
                        <MenuItem Header="影像配准" Click="OnRegistration"/>
                        <MenuItem Header="批量影像配准" Click="OnBatchRegistration"/>
                        <Separator/>
                        <MenuItem Header="影像融合" Click="OnImageFusion"/>
                        <MenuItem Header="批量影像融合" Click="OnBatchImageFusion"/>
                        <Separator/>
                        <MenuItem Header="影像拼接（匀色消缝）…" Click="OnRasterMosaic"/>
                        <Separator/>
                        <MenuItem x:Name="RasterSwipeMenuItem" Header="卷帘对比"
                                  IsCheckable="True" Click="OnRasterSwipeClick"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,0,0,1" Padding="9,2,8,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="14"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" ToolTip="新建" Click="OnFileNew">
                        <StackPanel>
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                                <Path Stroke="#2F4058" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="#FFFFFF"
                                      Data="M6,3.5 H15 L19,7.5 V20.5 H6 Z"/>
                                <Path Stroke="#2F4058" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="#EAF2FF"
                                      Data="M15,3.5 V7.5 H19"/>
                            </Canvas>
                            <TextBlock Style="{StaticResource ToolLabel}" Text="新建"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="打开项目" Click="OnOpenFileClick">
                        <StackPanel>
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                                <Path Stroke="#48677A" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="#EEF3F5"
                                      Data="M3.5,8 H9.2 L11,10 H20.5 V18.8 H3.5 Z"/>
                                <Path Stroke="#48677A" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="#DCE8ED"
                                      Data="M3.5,8 V6 H9.5 L11.2,8 Z"/>
                            </Canvas>
                            <TextBlock Style="{StaticResource ToolLabel}" Text="打开"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="添加数据" Click="OnAddDataClick">
                        <StackPanel>
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                                <Path Stroke="#48677A" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="#E4EDF1"
                                      Data="M12,3.8 L19,7.8 L12,11.8 L5,7.8 Z"/>
                                <Path Stroke="#48677A" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="#D7E3E9"
                                      Data="M5,7.8 V15.7 L12,20 V11.8 Z"/>
                                <Path Stroke="#1677A8" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="#C8E1EA"
                                      Data="M19,7.8 V15.7 L12,20 V11.8 Z"/>
                                <Path Stroke="#2F4058" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M12,6.4 V9.6 M10.4,8 H13.6"/>
                            </Canvas>
                            <TextBlock Style="{StaticResource ToolLabel}" Text="添加数据"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="保存项目" Click="OnMenuSave">
                        <StackPanel>
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                                <Path Stroke="#3F5E72" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="#E8F0F4"
                                      Data="M5,4 H16 L20,8 V20 H5 Z"/>
                                <Rectangle Canvas.Left="8" Canvas.Top="5" Width="8" Height="6" RadiusX="1" RadiusY="1"
                                           Stroke="#1677A8" StrokeThickness="1.4" Fill="#B9DCE8"/>
                                <Path Stroke="#2F4058" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="#FFFFFF"
                                      Data="M8,15 H17 V20 H8 Z"/>
                            </Canvas>
                            <TextBlock Style="{StaticResource ToolLabel}" Text="保存"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource ToolGroupLabel}" Text="项目"/>
                </Grid>

                <Border Style="{StaticResource ToolSep}"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="14"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="PanBtn" Style="{StaticResource ToolToggle}" IsChecked="True"
                                  ToolTip="平移" Click="OnPanClick">
                        <StackPanel>
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                                <Path Stroke="#1677A8" StrokeThickness="1.75" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="#DDEBFF"
                                      Data="M7.9,12.3 V8.5 A1.35,1.35 0 0,1 10.6,8.5 V11.7
                                            M10.6,11.7 V6.6 A1.35,1.35 0 0,1 13.3,6.6 V11.6
                                            M13.3,11.6 V7.6 A1.35,1.35 0 0,1 16,7.6 V12.1
                                            M16,12.1 V9.8 A1.35,1.35 0 0,1 18.7,9.8 V14
                                            C18.7,17.4 16.7,20.1 13.7,20.1 H11
                                            C9.4,20.1 8.1,19.1 7.3,17.7 L5.4,14.5
                                            A1.15,1.15 0 0,1 7.2,12.9 L7.9,13.7"/>
                                <Path Stroke="#1677A8" StrokeThickness="1.2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Data="M10.6,11.2 V12.5 M13.3,11.1 V12.4 M16,11.6 V12.8"/>
                            </Canvas>
                            <TextBlock Style="{StaticResource ToolLabel}" Text="平移"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource ToolButton}" ToolTip="放大" Click="OnZoomInClick">
                        <StackPanel>
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                                <Path Stroke="#2F4058" StrokeThickness="1.9" StrokeLineJoin="Round" Fill="#F8FBFF"
                                      Data="M10.5,4 A6.2,6.2 0 1,0 10.5,16.4 A6.2,6.2 0 1,0 10.5,4 Z"/>
                                <Path Stroke="#1677A8" StrokeThickness="1.8" StrokeStartLineCap="Round" Data="M10.5,7.6 V12.8 M7.9,10.2 H13.1"/>
                                <Path Stroke="#2F4058" StrokeThickness="1.9" StrokeStartLineCap="Round" Data="M15.2,15.2 L20.5,20.5"/>
                            </Canvas>
                            <TextBlock Style="{StaticResource ToolLabel}" Text="放大"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="缩小" Click="OnZoomOutClick">
                        <StackPanel>
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                                <Path Stroke="#2F4058" StrokeThickness="1.9" StrokeLineJoin="Round" Fill="#F8FBFF"
                                      Data="M10.5,4 A6.2,6.2 0 1,0 10.5,16.4 A6.2,6.2 0 1,0 10.5,4 Z"/>
                                <Path Stroke="#1677A8" StrokeThickness="1.8" StrokeStartLineCap="Round" Data="M7.9,10.2 H13.1"/>
                                <Path Stroke="#2F4058" StrokeThickness="1.9" StrokeStartLineCap="Round" Data="M15.2,15.2 L20.5,20.5"/>
                            </Canvas>
                            <TextBlock Style="{StaticResource ToolLabel}" Text="缩小"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="全图显示" Click="OnFullExtentClick">
                        <StackPanel>
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                                <Path Stroke="#2F4058" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Data="M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15"/>
                                <Rectangle Canvas.Left="8" Canvas.Top="8" Width="8" Height="8" Stroke="#1677A8"
                                           StrokeThickness="1.5" Fill="#F8FBFF"/>
                            </Canvas>
                            <TextBlock Style="{StaticResource ToolLabel}" Text="全图"/>
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="OverviewBtn" Style="{StaticResource ToolToggle}"
                                  IsChecked="False" ToolTip="显示或隐藏鹰眼地图"
                                  Click="OnOverviewToggleClick">
                        <StackPanel>
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                                <Path Stroke="#2F4058" StrokeThickness="1.5" StrokeLineJoin="Round"
                                      Fill="#E6EEF2" Data="M3.5,6 L9,3.5 L14.5,6 L20.5,3.5 V18 L15,20.5 L9.5,18 L3.5,20.5 Z"/>
                                <Path Stroke="#7A94A4" StrokeThickness="1.3" Fill="Transparent"
                                      Data="M9,3.5 V18 M14.5,6 V20.5"/>
                                <Rectangle Canvas.Left="8" Canvas.Top="8" Width="9" Height="7"
                                           Stroke="#E4572E" StrokeThickness="1.8" Fill="#18E4572E"/>
                            </Canvas>
                            <TextBlock Style="{StaticResource ToolLabel}" Text="鹰眼"/>
                        </StackPanel>
                    </ToggleButton>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource ToolGroupLabel}" Text="地图导航"/>
                </Grid>

                <Border Style="{StaticResource ToolSep}"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="14"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="IdentifyBtn" Style="{StaticResource ToolToggle}"
                                  ToolTip="识别像素值" Click="OnIdentifyClick">
                        <StackPanel>
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                                <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6"
                                         Stroke="#2F4058" StrokeThickness="1.7" Fill="#FFFFFF"/>
                                <Path Stroke="#2F4058" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Data="M12,4 V7 M12,17 V20 M4,12 H7 M17,12 H20"/>
                                <Path Stroke="#1677A8" StrokeThickness="1.7" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Data="M6.4,6.4 L8.5,8.5 M17.6,6.4 L15.5,8.5 M6.4,17.6 L8.5,15.5 M17.6,17.6 L15.5,15.5"/>
                            </Canvas>
                            <TextBlock Style="{StaticResource ToolLabel}" Text="识别"/>
                        </StackPanel>
                    </ToggleButton>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource ToolGroupLabel}" Text="查询"/>
                </Grid>

                <Border Style="{StaticResource ToolSep}"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="14"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="RasterSwipeBtn" Style="{StaticResource ToolToggle}"
                                  ToolTip="融合前后卷帘对比" Click="OnRasterSwipeClick">
                        <StackPanel>
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center">
                                <Rectangle Canvas.Left="3.5" Canvas.Top="4" Width="8.5" Height="16"
                                           Stroke="#2F4058" StrokeThickness="1.5" Fill="#DCEAF2"/>
                                <Rectangle Canvas.Left="12" Canvas.Top="4" Width="8.5" Height="16"
                                           Stroke="#2F4058" StrokeThickness="1.5" Fill="#B9DCE8"/>
                                <Path Stroke="#1677A8" StrokeThickness="2" StrokeStartLineCap="Round"
                                      Data="M12,2.5 V21.5"/>
                                <Path Stroke="#1677A8" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Data="M9.5,12 H14.5 M9.5,12 L11,10.5 M9.5,12 L11,13.5 M14.5,12 L13,10.5 M14.5,12 L13,13.5"/>
                            </Canvas>
                            <TextBlock Style="{StaticResource ToolLabel}" Text="卷帘"/>
                        </StackPanel>
                    </ToggleButton>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource ToolGroupLabel}" Text="影像对比"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="8,8,8,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" MinWidth="240"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                    CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#E7EDF1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Accent}"/>
                        <StackPanel Grid.Column="1" Margin="11,8,8,7">
                            <TextBlock Text="内容" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#223746"/>
                            <TextBlock Text="图层与绘制顺序" FontSize="10.5" Foreground="#6A7F8F" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="#C5D0D8"/>

                    <Grid Grid.Row="2" Margin="11,10,11,8">
                        <TextBox x:Name="LayerSearchBox" Style="{StaticResource SearchBox}"
                                 TextChanged="OnLayerSearchTextChanged"/>
                        <Path Style="{StaticResource IconPath}" Width="14" Height="14"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="9,0,0,0" Stroke="#94A3B8"
                              Data="M6,2 A4,4 0 1,0 6,10 A4,4 0 1,0 6,2 Z M9,9 L13,13"/>
                        <TextBlock Text="搜索图层" Foreground="#9AA8B8" FontSize="12"
                                   Margin="30,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=LayerSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ListBox x:Name="LayerListBox" Grid.Row="3" Margin="7,0,7,5"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             AllowDrop="True" SelectionMode="Extended"
                             PreviewMouseRightButtonDown="OnLayerListRightClick"
                             PreviewMouseMove="OnLayerListPreviewMouseMove"
                             Drop="OnLayerListDrop">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#E9EFF3" BorderBrush="#CDD7DE" BorderThickness="0,0,0,1"
                                                CornerRadius="2" Padding="8,5" Margin="4,7,4,3">
                                            <TextBlock Text="{Binding Name}" Foreground="#38566B"
                                                       FontSize="11.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="3,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="Transparent" BorderThickness="1"
                                                    CornerRadius="2" Padding="0">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#EDF3F6"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#CFDCE3"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#DDECF2"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#6AA2B9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,5" MinWidth="0" ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="ExpandBtn" Grid.Column="0"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  Width="18" Height="18" Margin="0,1,4,0"
                                                  VerticalAlignment="Top"
                                                  Visibility="{Binding HasLegend, Converter={StaticResource BoolToVis}}"
                                                  Template="{StaticResource ExpandToggle}"/>

                                    <StackPanel Grid.Column="1" MinWidth="0">
                                        <Grid MinWidth="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}"
                                                      VerticalAlignment="Center" Margin="0,0,7,0"
                                                      PreviewMouseLeftButtonDown="OnLayerCheckBoxPreviewMouseLeftButtonDown"
                                                      Click="OnLayerVisibilityChanged"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextMain}"
                                                       FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <TextBlock Text="{Binding LayerTypeLabel}" Foreground="{StaticResource TextMuted}"
                                                   FontSize="11.5" Margin="22,2,0,0"/>

                                        <StackPanel Margin="22,8,0,2"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Visibility="{Binding ShowGray, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="值" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                                <DockPanel>
                                                    <Rectangle Width="14" Height="56" RadiusX="3" RadiusY="3"
                                                               Fill="{Binding Legend.RampBrush}" Margin="0,0,8,0"/>
                                                    <StackPanel>
                                                        <TextBlock FontSize="11.5" Foreground="#526170"
                                                                   Text="{Binding Legend.MaxValue, StringFormat='高：{0:F2}'}"/>
                                                        <TextBlock FontSize="11.5" Foreground="#526170" Margin="0,29,0,0"
                                                                   Text="{Binding Legend.MinValue, StringFormat='低：{0:F2}'}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding ShowRgb, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="RGB" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Width="10" Height="10" Fill="#EF2A2A" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Legend.RedBand}" Foreground="{StaticResource TextMain}" FontSize="11.5" Margin="4,0,0,0"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Width="10" Height="10" Fill="#28C840" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Legend.GreenBand}" Foreground="{StaticResource TextMain}" FontSize="11.5" Margin="4,0,0,0"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Width="10" Height="10" Fill="#2F6BFF" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Legend.BlueBand}" Foreground="{StaticResource TextMain}" FontSize="11.5" Margin="4,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3" Panel.ZIndex="1" Margin="18,22" Background="Transparent"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=LayerListBox}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="210">
                            <Grid Width="46" Height="42" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Stroke="#A7B7C2" StrokeThickness="1.4" StrokeLineJoin="Round"
                                      Fill="#EFF3F5" Data="M23,3 L42,13 L23,23 L4,13 Z"/>
                                <Path Stroke="#8FA5B3" StrokeThickness="1.4" StrokeLineJoin="Round"
                                      Fill="#E5ECEF" Data="M4,20 L23,30 L42,20 M4,27 L23,37 L42,27"/>
                            </Grid>
                            <TextBlock Text="暂无图层" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#526B7A" HorizontalAlignment="Center"/>
                            <TextBlock Text="添加数据后，可在这里管理图层与绘制顺序"
                                       FontSize="10.5" Foreground="#8A9AA5" TextAlignment="Center"
                                       TextWrapping="Wrap" LineHeight="17" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="OverviewPanel" Grid.Row="4"
                            Height="220" Margin="7,0,7,6"
                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                            Background="#F8FAFC" BorderBrush="#7892A3" BorderThickness="1"
                            CornerRadius="4" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#E7EDF1" BorderBrush="#B9C8D2" BorderThickness="0,0,0,1"
                                    CornerRadius="4,4,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="#42647A"
                                              StrokeThickness="1.3" StrokeLineJoin="Round" Fill="Transparent"
                                              Data="M1,4 L5,1 L9,4 L13,1 V10 L9,13 L5,10 L1,13 Z M5,1 V10 M9,4 V13"/>
                                        <TextBlock Text="鹰眼地图" Foreground="#294155" FontSize="11.5"
                                                   FontWeight="SemiBold" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <Button Width="26" Height="24" HorizontalAlignment="Right" Margin="0,0,3,0"
                                            ToolTip="关闭鹰眼地图" Click="OnOverviewCloseClick"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="#526678" FontSize="16" Content="×"/>
                                </Grid>
                            </Border>
                            <Grid x:Name="OverviewMapHost" Grid.Row="1" Background="#EDF2F5"
                                  SizeChanged="OnOverviewMapSizeChanged">
                                <mapsui:MapControl x:Name="OverviewMapControl" IsHitTestVisible="False"/>
                                <Canvas x:Name="OverviewInteractionCanvas" Background="Transparent"
                                        MouseLeftButtonDown="OnOverviewMouseLeftButtonDown">
                                    <Thumb x:Name="OverviewViewportThumb" Cursor="SizeAll"
                                           DragDelta="OnOverviewViewportDragDelta">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#20E4572E" BorderBrush="#E4572E"
                                                        BorderThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="5" BorderBrush="#D6DEE4" BorderThickness="0,1,0,0" Padding="11,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="12" Stretch="Uniform" Stroke="#7A8E9C" StrokeThickness="1.4"
                                  Data="M2,4 L6,1 L10,4 M2,8 L6,11 L10,8"/>
                            <TextBlock Text="拖拽图层可调整绘制顺序" FontSize="10.5" Foreground="#758896" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" Background="Transparent"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ShowsPreview="True"/>

            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F4F6F8" BorderBrush="#CBD5DC" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="3" Background="{StaticResource Accent}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                <Path Width="15" Height="15" Stretch="Uniform" Stroke="#42647A" StrokeThickness="1.35"
                                      StrokeLineJoin="Round" Fill="Transparent"
                                      Data="M1,4 L5,1 L9,4 L13,1 V10 L9,13 L5,10 L1,13 Z M5,1 V10 M9,4 V13"/>
                                <TextBlock Text="地图视图" Foreground="#294155" FontWeight="SemiBold" FontSize="12"
                                           VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Background="#DDE4E8" Margin="0">
                    <mapsui:MapControl x:Name="MapControl"/>
                    <controls:GpuRasterMapControl x:Name="GpuRasterMap"/>
                    <Border Panel.ZIndex="4" Background="#F8FAFB">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=LayerListBox}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330">
                            <Grid Width="72" Height="64" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Path Stroke="#9CB0BD" StrokeThickness="1.5" StrokeLineJoin="Round"
                                      Fill="#E7EEF2" Data="M7,17 L26,6 L46,17 L65,6 V47 L46,58 L26,47 L7,58 Z"/>
                                <Path Stroke="#7F99A9" StrokeThickness="1.5" Fill="Transparent"
                                      Data="M26,6 V47 M46,17 V58"/>
                                <Ellipse Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="#D7EAF1" Stroke="#1677A8" StrokeThickness="1.7"/>
                            </Grid>
                            <TextBlock Text="开始创建地图" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#334F61" HorizontalAlignment="Center"/>
                            <TextBlock Text="当前地图中还没有数据图层"
                                       FontSize="11.5" Foreground="#788C99" HorizontalAlignment="Center"
                                       Margin="0,6,0,15"/>
                            <Button Content="添加数据" Style="{StaticResource EmptyActionButton}"
                                    HorizontalAlignment="Center" Click="OnAddDataClick"/>
                        </StackPanel>
                    </Border>
                    <Canvas x:Name="IdentifyMarkerCanvas" IsHitTestVisible="False">
                        <Ellipse x:Name="IdentifyDot" Width="10" Height="10"
                                 Fill="#EF4444" Stroke="#FFFFFF" StrokeThickness="1.5"
                                 Visibility="Collapsed" Canvas.Left="0" Canvas.Top="0"/>
                    </Canvas>
                    <Canvas x:Name="ClipSelectionCanvas" IsHitTestVisible="False" Visibility="Collapsed">
                        <Rectangle x:Name="ClipSelectionRectangle"
                                   Visibility="Collapsed"
                                   Fill="Transparent" Stroke="#2563EB" StrokeThickness="2"/>
                        <Thumb x:Name="ClipMoveThumb" Tag="Move" Background="Transparent"
                               Opacity="0" Cursor="SizeAll" Visibility="Collapsed"
                               DragDelta="OnClipThumbDragDelta"/>
                        <Thumb x:Name="ClipHandleNW" Tag="NW" Width="10" Height="10" Background="#FFFFFF"
                               BorderBrush="#2563EB" BorderThickness="2" Cursor="SizeNWSE"
                               Visibility="Collapsed" DragDelta="OnClipThumbDragDelta"/>
                        <Thumb x:Name="ClipHandleN" Tag="N" Width="10" Height="10" Background="#FFFFFF"
                               BorderBrush="#2563EB" BorderThickness="2" Cursor="SizeNS"
                               Visibility="Collapsed" DragDelta="OnClipThumbDragDelta"/>
                        <Thumb x:Name="ClipHandleNE" Tag="NE" Width="10" Height="10" Background="#FFFFFF"
                               BorderBrush="#2563EB" BorderThickness="2" Cursor="SizeNESW"
                               Visibility="Collapsed" DragDelta="OnClipThumbDragDelta"/>
                        <Thumb x:Name="ClipHandleE" Tag="E" Width="10" Height="10" Background="#FFFFFF"
                               BorderBrush="#2563EB" BorderThickness="2" Cursor="SizeWE"
                               Visibility="Collapsed" DragDelta="OnClipThumbDragDelta"/>
                        <Thumb x:Name="ClipHandleSE" Tag="SE" Width="10" Height="10" Background="#FFFFFF"
                               BorderBrush="#2563EB" BorderThickness="2" Cursor="SizeNWSE"
                               Visibility="Collapsed" DragDelta="OnClipThumbDragDelta"/>
                        <Thumb x:Name="ClipHandleS" Tag="S" Width="10" Height="10" Background="#FFFFFF"
                               BorderBrush="#2563EB" BorderThickness="2" Cursor="SizeNS"
                               Visibility="Collapsed" DragDelta="OnClipThumbDragDelta"/>
                        <Thumb x:Name="ClipHandleSW" Tag="SW" Width="10" Height="10" Background="#FFFFFF"
                               BorderBrush="#2563EB" BorderThickness="2" Cursor="SizeNESW"
                               Visibility="Collapsed" DragDelta="OnClipThumbDragDelta"/>
                        <Thumb x:Name="ClipHandleW" Tag="W" Width="10" Height="10" Background="#FFFFFF"
                               BorderBrush="#2563EB" BorderThickness="2" Cursor="SizeWE"
                               Visibility="Collapsed" DragDelta="OnClipThumbDragDelta"/>
                        <StackPanel x:Name="ClipSelectionActions" Orientation="Horizontal" Visibility="Collapsed">
                            <Button Content="裁剪" Width="58" Height="26" Click="OnConfirmRectangleClip"
                                    Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="取消" Width="58" Height="26" Margin="6,0,0,0"
                                    Click="OnCancelRectangleClip" Background="#E5E7EB"
                                    Foreground="#334155" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Canvas>
                    <Canvas x:Name="SwipeOverlayCanvas" Visibility="Collapsed"
                            ClipToBounds="True" SizeChanged="OnSwipeOverlaySizeChanged">
                        <Border x:Name="SwipeLeftLabel" Canvas.Left="12" Canvas.Top="12"
                                Background="#D9162738" BorderBrush="#E6FFFFFF" BorderThickness="1"
                                CornerRadius="12" Padding="10,5" IsHitTestVisible="False">
                            <TextBlock x:Name="SwipeLeftLabelText" Foreground="White"
                                       FontSize="11.5" FontWeight="SemiBold" MaxWidth="190"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Border x:Name="SwipeRightLabel" Canvas.Right="12" Canvas.Top="12"
                                Background="#D9162738" BorderBrush="#E6FFFFFF" BorderThickness="1"
                                CornerRadius="12" Padding="10,5" IsHitTestVisible="False">
                            <TextBlock x:Name="SwipeRightLabelText" Foreground="White"
                                       FontSize="11.5" FontWeight="SemiBold" MaxWidth="190"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Thumb x:Name="SwipeThumb" Width="52" Canvas.Top="0"
                               Background="Transparent" Cursor="SizeWE"
                               DragDelta="OnSwipeThumbDragDelta">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Grid Background="Transparent">
                                        <Border Width="5" Background="#BFFFFFFF" HorizontalAlignment="Center"/>
                                        <Border Width="3" Background="#F97316" HorizontalAlignment="Center"/>
                                        <Border Width="38" Height="44" CornerRadius="9"
                                                Background="#F97316" BorderBrush="#FFFFFF" BorderThickness="2"
                                                VerticalAlignment="Center">
                                            <Canvas Width="38" Height="44"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Stroke="#FFFFFF" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M5,22 H15 M5,22 L10,17 M5,22 L10,27"/>
                                                <Path Stroke="#FFFFFF" StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Data="M33,22 H23 M33,22 L28,17 M33,22 L28,27"/>
                                            </Canvas>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Canvas>
                    <Border x:Name="ProgressPanel" Panel.ZIndex="20"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="#F8FAFC" BorderBrush="#9FB2BF" BorderThickness="1"
                            CornerRadius="3" Padding="12,9" Margin="0,0,14,12"
                            Visibility="Collapsed" MinWidth="250">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock x:Name="ProgressLabel" Text="处理中..." FontSize="12"
                                           Foreground="{StaticResource TextMain}" Width="220"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="CancelTaskButton" Content="取消" Width="42" Height="22"
                                        HorizontalAlignment="Right" Click="OnCancelTaskClick"
                                        IsEnabled="False" Background="#FEE2E2" Foreground="#B91C1C"
                                        BorderThickness="0" Cursor="Hand"/>
                            </Grid>
                            <ProgressBar x:Name="ProgressBar" Height="6" Width="220"
                                         IsIndeterminate="False" Minimum="0" Maximum="100"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#F7F9FA" BorderBrush="{StaticResource BorderSoft}"
                BorderThickness="0,1,0,0" Padding="12,0" Height="29">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="6" Height="6" Fill="#2F9A78" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="CoordText" Text="-" FontSize="11.5" Margin="8,0,0,0"
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
